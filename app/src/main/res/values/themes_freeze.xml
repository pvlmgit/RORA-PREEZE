<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FreezeApps" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_amoled_background</item>
    </style>
    <style name="Theme.FreezeApps.Splash" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splash_amoled_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.FreezeApps</item>
    </style>
    <style name="Theme.FreezeApps.Translucent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>